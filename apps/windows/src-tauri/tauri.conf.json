{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2gether", "version": "0.1.0", "identifier": "app.together.v2.windows",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "2gether", "width": 1100, "height": 800, "minWidth": 640, "minHeight": 600 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:" } },
  "bundle": { "active": false }
}
